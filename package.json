{
  "name": "larkflare-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Larkflare monorepo: Cloudflare-shaped serverless data products (D1, Vectorize, R2) built on Feishu/Lark Bitable and Drive",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ztxtxwd/larkflare.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "bench": "pnpm --filter @larkflare/db bench",
    "bench:mock": "pnpm --filter @larkflare/db bench:mock",
    "bench:vector": "pnpm --filter @larkflare/vectorize bench"
  }
}
