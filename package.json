{
  "name": "larkbase-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Larkbase monorepo: a headless serverless NoSQL engine on Feishu/Lark Bitable and its zero-infra vector search extension",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ztxtxwd/larkbase.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "bench": "pnpm --filter @larkbase/core bench",
    "bench:mock": "pnpm --filter @larkbase/core bench:mock",
    "bench:vector": "pnpm --filter @larkbase/vector bench"
  }
}
